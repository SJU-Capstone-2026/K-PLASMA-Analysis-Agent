{
  "name": "kplasma-analysis-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "agent"],
  "engines": { "node": "22.23.3", "npm": ">=10 <12" },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:agent": "node scripts/agent/worker.mjs",
    "test:agent": "cd agent/python && uv run --frozen --extra tracing pytest -c pytest-v2.ini",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc --project frontend/e2e/tsconfig.json",
    "test": "npm run test --workspaces && node --test scripts/reference/*.test.mjs",
    "lint": "eslint frontend agent",
    "reference:check": "node scripts/reference/check.mjs",
    "test:e2e": "node scripts/agent/verify-v2.mjs",
    "test:e2e:v2": "node scripts/agent/verify-v2.mjs",
    "test:e2e:live": "node scripts/agent/verify-v2.mjs --live",
    "test:ui:v2": "npm exec --workspace frontend -- playwright test --config agent-v2-ui.playwright.config.ts",
    "test:agent:restart": "node scripts/agent/restart-verification.mjs",
    "test:e2e:legacy": "node scripts/reference/verify.mjs",
    "verify:reference": "node scripts/reference/verify.mjs --reference",
    "verify:agent-reference": "node scripts/agent/reference-parity.mjs",
    "verify:public-files": "node scripts/verify-public-files.mjs",
    "test:ui:historical": "playwright test --config frontend/task9.playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.5.0",
    "typescript-eslint": "8.71.0"
  }
}
