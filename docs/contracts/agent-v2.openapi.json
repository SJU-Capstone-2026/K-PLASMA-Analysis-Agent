              "schema": {
                "type": "object",
                "required": [
                  "claimGeneration",
                  "requestRevision",
                  "planRevision",
                  "stepId",
                  "payload"
                ],
                "properties": {
                  "claimGeneration": {
                    "type": "integer"
                  },
                  "requestRevision": {
                    "type": "integer"
                  },
                  "planRevision": {
                    "type": "integer"
                  },
                  "stepId": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fenced v2 result"
          },
          "409": {
            "description": "Stale fence, conflict or exhausted budget"
          }
        }
      }
    },
