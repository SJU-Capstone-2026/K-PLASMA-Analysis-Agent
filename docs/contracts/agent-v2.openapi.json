      }
    },
    "schemas": {
      "GraphV2AnswerSnapshotV1": {
        "$ref": "agent-v2.answer.schema.json"
      },
      "PublicEvent": {
        "$ref": "agent-v1.openapi.yaml#/components/schemas/PublicEvent"
      },
      "PublicEventPage": {
        "$ref": "agent-v1.openapi.yaml#/components/schemas/PublicEventPage"
      },
      "ProgressSnapshot": {
        "$ref": "agent-v1.openapi.yaml#/components/schemas/ProgressSnapshot"
      },
      "ExecutionSummary": {
