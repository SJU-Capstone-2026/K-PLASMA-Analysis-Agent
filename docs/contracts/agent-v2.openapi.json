    "/api/agent/requests": {
      "post": {
        "summary": "Submit a question and optionally select its new conversation graph",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "stateToken"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "stateToken": {
                    "type": "object"
                  },
                  "graphVersion": {
                    "type": "string",
                    "enum": [
                      "v1",
                      "v2"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted"
          },
          "409": {
            "description": "Stale workspace or pinned graph mismatch"
          }
        }
      }
    },
    "/api/agent/requests/{id}/events": {
