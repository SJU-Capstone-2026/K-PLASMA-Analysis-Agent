{
  "openapi": "3.1.0",
  "info": {
    "title": "K-PLASMA Graph v2 additions",
    "version": "1.0.0",
    "description": "Graph v2 uses the shared additive public event, SSE/JSON replay, preview and executionSummary contract in agent-v1.openapi.yaml. A results.ready binding contains only saved, verified current-graph tool executions; old versioned bindings remain immutable. Replaying events never re-executes a model or tool."
  },
  "paths": {
    "/internal/agent/requests/{id}/plans": {
      "post": {
        "summary": "Accept a checked plan revision",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "WorkerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "claimGeneration",
                  "requestRevision",
                  "payload"
                ],
                "properties": {
                  "claimGeneration": {
                    "type": "integer"
                  },
                  "requestRevision": {
                    "type": "integer"
                  },
                  "payload": {
                    "$ref": "agent-v2.plan.schema.json"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fenced v2 result"
          },
          "409": {
            "description": "Stale fence, conflict or exhausted budget"
          }
        }
      }
    },
