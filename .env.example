# Local development only. Set a password in your ignored .env file.
POSTGRES_DB=kplasma
POSTGRES_USER=kplasma
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/kplasma
BACKEND_PORT=8080
# bootRun runs from backend/, so this resolves to backend/storage/.
KPLASMA_STORAGE_ROOT=./storage
VITE_API_TARGET=http://localhost:8080
