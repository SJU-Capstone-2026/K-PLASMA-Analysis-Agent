# Local development only. Set a password in your ignored .env file.
POSTGRES_DB=kplasma
POSTGRES_USER=kplasma
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/kplasma
BACKEND_PORT=8080
# Local single-workspace API has no user authentication. Keep loopback unless
# an authenticated reverse proxy and deployment access controls are configured.
SERVER_ADDRESS=127.0.0.1
# bootRun runs from backend/, so this resolves to backend/storage/.
KPLASMA_STORAGE_ROOT=./storage
VITE_API_TARGET=http://localhost:8080

# Graph v1. New requests never use the retained JavaScript fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

# The optional Agent v2 planner uses a separate model setting.
AGENT_V2_PLAN_MODEL=gpt-6-luna
AGENT_V2_PLAN_REASONING_EFFORT=low
AGENT_V2_ANSWER_MODEL=gpt-6-luna
AGENT_V2_ANSWER_REASONING_EFFORT=low
AGENT_V2_DECISIONS_MODEL=gpt-6-luna
# Plan review is enabled; live Agent evaluations require it. Disable only for rollback.
AGENT_V2_PLAN_REVIEW_ENABLED=true

# Independent Agent v3. Feature switches are saved per API request as v3Options,
# not read retroactively from environment variables.
AGENT_V3_PLAN_MODEL=gpt-6-luna
AGENT_V3_PLAN_REASONING_EFFORT=low
AGENT_V3_ANSWER_MODEL=gpt-6-luna
AGENT_V3_ANSWER_REASONING_EFFORT=low
AGENT_V3_DECISIONS_MODEL=gpt-6-luna
AGENT_V3_PLAN_REVIEW_ENABLED=true
# Set these to your own private model/index directories before enabling V3 RAG.
AGENT_V3_RAG_MODEL_DIR=./.local/models/multilingual-e5-small
AGENT_V3_RAG_CACHE_DIR=./.local/v3-rag-cache
# Set true only when the judgment records are explicitly synthetic.
AGENT_V3_RAG_SYNTHETIC=false
# Generate a private random value; share the SAME value with backend and worker.
AGENT_WORKER_TOKEN=
# Optional if backend runs elsewhere; otherwise BACKEND_PORT is used.
# AGENT_BACKEND_URL=http://localhost:8080
AGENT_MODEL_TIMEOUT_SECONDS=90

# Optional Phoenix Cloud tracing. Includes question, node state and LLM input/output.
# uv sync --project agent/python --frozen --extra tracing
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=K-PLASMA
PHOENIX_API_KEY=
