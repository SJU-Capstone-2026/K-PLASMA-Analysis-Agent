# Copy to the ignored .env.local-llm file. Never source this file as shell code.
# Configure the pinned local files and generate a full-stack measurement before start.
AGENT_V2_LOCAL_LLM_BACKEND_URL=http://127.0.0.1:8080
# Shared backend: match AGENT_LOCAL_WORKER_TOKEN; keep AGENT_WORKER_TOKEN for cloud workers.
# Local-only backend: the existing AGENT_WORKER_TOKEN remains supported.
AGENT_V2_LOCAL_LLM_WORKER_TOKEN=
AGENT_V2_LOCAL_LLM_QWEN_URL=http://127.0.0.1:8082/v1
AGENT_V2_LOCAL_LLM_QWEN_TOKEN=
AGENT_V2_LOCAL_LLM_D1_URL=http://127.0.0.1:8083/v1/systemone
AGENT_V2_LOCAL_LLM_D1_TOKEN=
AGENT_V2_LOCAL_LLM_PLAN_REVIEW_ENABLED=true
AGENT_V2_LOCAL_LLM_D1_ENGINE=mlx
AGENT_V2_LOCAL_LLM_D1_PRECISION=q4
AGENT_V2_LOCAL_LLM_D1_INPUT_PROFILE=en-compact-no-view
AGENT_V2_LOCAL_LLM_D1_CONTEXT_MODE=per_check
AGENT_V2_LOCAL_LLM_D1_MODEL=perplexity-ai/pplx-decider-flash-v1.2:MLX4
AGENT_V2_LOCAL_LLM_D1_GROUP_SIZE=1
AGENT_V2_LOCAL_LLM_D1_INDEPENDENT_BATCH_SIZE=1

# Qwen planner disk KV cache; enable only with matching fresh memory evidence.
# Relative paths are resolved against this code checkout, not the shell's cwd.
# The Qwen server must use the same resolved directory with --slot-save-path.
AGENT_V2_LOCAL_LLM_QWEN_PLAN_CACHE_ENABLED=false
AGENT_V2_LOCAL_LLM_QWEN_PLAN_CACHE_DIR=.local/cache/v2_localLLM/qwen-plan-cache-KV

# Record the actual model snapshot revisions and pinned runtime versions.
# Qwen: unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# Reviewer: Perplexity Decider Flash v1.2, MLX affine4/group64 with its original decision readout.
AGENT_V2_LOCAL_LLM_MODEL_REVISION=
AGENT_V2_LOCAL_LLM_D1_REVISION=9ff7cf9838e59df461c276b7699d56b244d2af58
AGENT_V2_LOCAL_LLM_RUNTIME_VERSION=llama.cpp-b12317-submit-plan
AGENT_V2_LOCAL_LLM_D1_RUNTIME_VERSION=mlx-decision-1.3.0@2527a733c97a3fd5e0de54ea19f74fd362ed1ad2
AGENT_V2_LOCAL_LLM_MODEL_PATH=
AGENT_V2_LOCAL_LLM_D1_MODEL_PATH=
# Qwen uses its GGUF tokenizer; d1 uses the unchanged tokenizer in its pinned model directory.
# Both input budgets use their authenticated native count endpoints.
# Optional numerical Qwen analysis: uv sync --extra local-llm-analysis (no model downloads).
# CPU retokenization is an estimate of component lengths; input budgets still use the native tokenizer.
AGENT_V2_LOCAL_LLM_TOKENIZER_PATH=
AGENT_V2_LOCAL_LLM_MEMORY_MEASUREMENT_PATH=
# strict requires normal pressure and zero added swap; development records warnings/swap and allows them.
# Both policies reject critical/unknown pressure; evidence is bound to the selected policy.
# Current development runs keep Docker at 1536MiB; this is a Docker VM setting, not a worker limit.
AGENT_V2_LOCAL_LLM_MEMORY_POLICY=development

# Qwen 24K retains 16K input + 6K plan output; full-stack memory evidence is still required.
# Qwen native server: --batch-size 256 --ubatch-size 256; d1 counts each complete singleton input.
AGENT_V2_LOCAL_LLM_QWEN_CONTEXT_TOKENS=24576
AGENT_V2_LOCAL_LLM_D1_CONTEXT_TOKENS=32768
AGENT_V2_LOCAL_LLM_D1_BATCH_TOKENS=16000
AGENT_V2_LOCAL_LLM_D1_UBATCH_TOKENS=16000

# The MLX reviewer runs each check independently, one at a time.
# Install its separate pinned environment in agent/python/runtimes/d1_mlx; never replace the shared venv.
# The service JSON must match precision=q4, group_size=1, independent_batch_size=1 and D1_MODEL_PATH.
# LiquidAI comparison uses q8 / LiquidAI/d1-2B:MLX8 or bf16 / LiquidAI/d1-2B:BF16.
# Match the service precision/model path, worker model path/revision and fresh preparation evidence.
# Input comparison profiles: ko-full -> en-full -> en-compact -> en-compact-no-view.
# Translate fixed instructions/contracts only; original questions, plans and evidence stay unchanged.
# Each projected review check must fit within 16000 tokens.
# The authenticated MLX /runtime and /unload controls confirm real release before Qwen wakes.

# Updates/downloads are allowed. Model payloads use only the pinned local servers; no cloud fallback.
# Models are resident in sequence on 24GB. Qwen uses --sleep-idle-seconds 1; MLX d1 unloads explicitly.
# No READY flag bypass is supported; status verifies artifacts, live contracts and measured memory.
# After native contract checks, both models must sleep and pressure must satisfy the selected policy for 5s within 60s.
# The wrapper starts only the private worker; backend/DB/frontend/browser are prepared separately.
# Supply backend/frontend settings to their own processes, never to the private model worker.
# Share the existing DB and storage; workers keep distinct keys and graph implementations.
AGENT_SUPPORTED_GRAPH_VERSIONS=v1,v2,v3,v2_localLLM
AGENT_DEFAULT_GRAPH_VERSION=v2_localLLM
AGENT_LOCAL_WORKER_TOKEN=
AGENT_LOCAL_RUNTIME_ENABLED=true
AGENT_LOCAL_UI_ORIGIN=http://127.0.0.1:5173
AGENT_LOCAL_API_HOST=127.0.0.1:8080
# Generate at least 32 random bytes; exchange it once through the loopback browser bootstrap.
AGENT_LOCAL_BOOTSTRAP_TOKEN=
VITE_AGENT_SUPPORTED_GRAPH_VERSIONS=v1,v2,v3,v2_localLLM
VITE_AGENT_DEFAULT_GRAPH_VERSION=v2_localLLM
VITE_API_TARGET=http://127.0.0.1:8080
